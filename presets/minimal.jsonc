{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": null,
    "display": {
        "key": {
            
        },
        "separator": " ",
    }, 
    "modules": [
	"break",
        {
	    "key": "{#white}┌─{#blue}󰀓",
	    "type": "title",
	},
        {
            "key": "{#white}├─{#blue}󰣇",
            "type": "os",
        },
        {
            "key": "{#white}├─{#blue}",
            "type": "kernel",
        },
        {
	    "key": "{#white}├─{#blue}",
            "type": "packages",
        },
        {
            "key": "{#white}├─{#blue}🗓",
            "type": "disk",
            "folders": "/",
            "format": "{days} Days",
        },
        {
	    "key": "{#white}├─{#blue}",
            "type": "shell",
        },
	{
	    "key": "{#white}├─{#blue}󰍛",
	    "type": "cpu",
	},
        {  
            "key": "{#white}├─{#blue}󰧨",
            "type": "gpu",
        },
        {  
            "key": "{#white}└─{#blue}󰑭",
            "type": "memory",
        }
    ]
}
